"""Case lighting control for the Alienware Aurora ACT1250 (AW-ELC controller, USB 187c:0550).

The protocol follows OpenRGB's Controllers/AlienwareController. On this
firmware (1.1.10, platform 0x0811):

- Replies echo each request. The one success signal is FINISH_PLAY/FINISH_SAVE
  reply byte 7 (report id counted as byte 0): 0x00 accepted, 0xFF rejected.
- A program naming a zone id at or past the 70 the controller reports is
  rejected whole and the lights don't change.
- Black (000000) isn't off: the zone shows an older stored animation instead.
  Off is sent as 010101.
- One select packet takes up to 25 zone ids. Programs of 70 select+action
  pairs, and of 13 pairs with 130 morph actions, are accepted; this stays
  within 13 pairs anyway, the limit OpenRGB issue #5822 found on the Area-51.
- LED drive is linear PWM (#5822), so colors are gamma-corrected.

Color cycle and wave chain the firmware's morph action, so they keep running
with the app closed and can be saved as the startup lighting.

Zone map (alienfx-tools #631, confirmed by eye):
  0-59   front vent ring, ten blocks of six alternating between the two sides
  63-65  alien head logo, three LEDs behind one diffuser
  68     rear fan
  69     CPU cooler
  60-62, 66 and 67 are unused; the GPU light isn't on this controller.

  alienware-lighting                                     open the window
  alienware-lighting 8000ff [--save]                     whole case one color
  alienware-lighting rainbow --logo ffffff --interior 8000ff
"""
import argparse
import colorsys
import fcntl
import glob
import json
import os
import random
import threading
import time

REPORT_SIZE = 33
BUF_SIZE = REPORT_SIZE + 1  # hidraw wants the (zero) report id in front

ZONES_PER_SELECT = 25

CMD_REPORT = 0x20
CMD_USER_ANIM = 0x21
CMD_SELECT_ZONES = 0x23
CMD_ADD_ACTION = 0x24

REPORT_CONFIG = 0x02

PLATFORM = 0x0811  # Aurora ACT1250; other AW-ELC machines have other zone maps

ANIM_NEW = 0x0001
ANIM_FINISH_SAVE = 0x0002
ANIM_FINISH_PLAY = 0x0003
ANIM_REMOVE = 0x0004
ANIM_SET_DEFAULT = 0x0006
ANIM_SET_STARTUP = 0x0007

SLOT_LIVE = 0xFFFF     # played immediately, not stored
SLOT_DEFAULT = 0x0061  # stored in controller flash, used at power-on

MODE_COLOR = 0x00
MODE_MORPH = 0x02
DURATION = 2000
TEMPO_MAX = 0x00FA
ACTIONS_PER_PACKET = 3

GAMMA = 2.0

RING_ZONES = list(range(0, 60))
LOGO_ZONES = [63, 64, 65]
REAR_FAN_ZONES = [68]
CPU_ZONES = [69]
# Lights that can follow the vent or take their own color, with their
# settings keys and names.
ACCENT_ZONES = [LOGO_ZONES, REAR_FAN_ZONES, CPU_ZONES]
ACCENT_KEYS = ["logo", "rear_fan", "cpu"]
ACCENT_NAMES = ["logo", "rear fan", "CPU cooler"]
BLOCK = 6
# Ring blocks (zone // 6) in order around the loop: up the right side from
# the bottom, then back down the left.
LOOP_ORDER = [0, 1, 3, 5, 7, 9, 8, 6, 4, 2]

APP_ID = "io.github.bhoult.AlienwareLighting"
CONFIG_PATH = os.path.expanduser("~/.config/alienware-lighting.json")
DEFAULTS = {"vent": "8000ff", "brightness": 100, "speed": 5,
            "logo_on": False, "logo_color": "ffffff",
            "rear_fan_on": False, "rear_fan_color": "8000ff",
            "cpu_on": False, "cpu_color": "8000ff",
            "random": None, "saved": None}

PRESETS = [
    ("Purple", "8000ff"),
    ("Violet", "b400ff"),
    ("Magenta", "ff00c8"),
    ("Red", "ff0000"),
    ("Orange", "ff5000"),
    ("Green", "00ff00"),
    ("Teal", "00ffb4"),
    ("Blue", "0000ff"),
    ("White", "ffffff"),
    ("Off", "000000"),
    ("Rainbow", "rainbow"),
    ("Random (click again to reshuffle)", "random"),
    ("Color cycle: everything fades through the spectrum together", "cycle"),
    ("Color wave: colors travel around the vent", "wave"),
]
ANIMATED = ("cycle", "wave")
PATTERNS = ("rainbow", "random") + ANIMATED


def _iowr(nr, size):
    return (3 << 30) | (size << 16) | (ord("H") << 8) | nr


HIDIOCSFEATURE = _iowr(0x06, BUF_SIZE)
HIDIOCGFEATURE = _iowr(0x07, BUF_SIZE)


class ControllerError(Exception):
    pass


def find_device():
    for path in glob.glob("/sys/class/hidraw/hidraw*"):
        with open(os.path.join(path, "device/uevent")) as f:
            if "HID_ID=0003:0000187C:00000550" in f.read():
                return "/dev/" + os.path.basename(path)
    raise ControllerError("Lighting controller (USB 187c:0550) not found")


class Elc:
    def __enter__(self):
        path = find_device()
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            raise ControllerError(f"No permission to open {path}; install 60-alienware-elc.rules (see README)")
        return self

    def __exit__(self, *exc):
        os.close(self.fd)

    def send(self, payload, delay=0.06):
        buf = bytearray(BUF_SIZE)
        buf[1] = 0x03
        buf[2 : 2 + len(payload)] = bytes(payload)
        fcntl.ioctl(self.fd, HIDIOCSFEATURE, bytes(buf))
        # The controller drops commands that arrive too quickly.
        time.sleep(delay)
        resp = bytearray(BUF_SIZE)
        fcntl.ioctl(self.fd, HIDIOCGFEATURE, resp, True)
        if resp[1] == 0:
            raise ControllerError("Lighting controller stopped responding")
        return resp

    def anim(self, sub, slot):
        slow = sub in (ANIM_FINISH_PLAY, ANIM_FINISH_SAVE)
        return self.send([CMD_USER_ANIM, sub >> 8, sub & 0xFF, slot >> 8, slot & 0xFF, 0, 0],
                         delay=1.0 if slow else 0.06)

    def config(self):
        """The platform id and zone count."""
        r = self.send([CMD_REPORT, REPORT_CONFIG])
        return r[4] << 8 | r[5], r[6]

    def program(self, slot, pairs, finish):
        """pairs holds (zones, actions), each action (mode, duration ms, tempo,
        rgb bytes). Zone lists longer than one packet become several pairs;
        #5822 found a selection split across packets rejected on the Area-51."""
        self.anim(ANIM_NEW, slot)
        for zones, acts in pairs:
            for i in range(0, len(zones), ZONES_PER_SELECT):
                chunk = zones[i : i + ZONES_PER_SELECT]
                self.send([CMD_SELECT_ZONES, 1, 0, len(chunk), *chunk])
                for j in range(0, len(acts), ACTIONS_PER_PACKET):
                    payload = [CMD_ADD_ACTION]
                    for mode, duration, tempo, rgb in acts[j : j + ACTIONS_PER_PACKET]:
                        payload += [mode, duration >> 8, duration & 0xFF, tempo >> 8, tempo & 0xFF, *rgb]
                    self.send(payload)
        if self.anim(finish, slot)[7] == 0xFF:
            raise ControllerError("The lighting controller rejected the pattern")


def hue(h):
    return "".join(f"{round(c * 255):02x}" for c in colorsys.hsv_to_rgb(h % 1.0, 1, 1))


# One hue per ring block, in loop order. The wave fades every block through
# these, each starting one step further round, so the colors travel the loop.
RAINBOW = [hue(i / len(LOOP_ORDER)) for i in range(len(LOOP_ORDER))]
# The color cycle fades everything through these together.
SPECTRUM = [hue(i / 7) for i in range(7)]


def random_colors(n=len(LOOP_ORDER) + len(ACCENT_ZONES)):
    """Vivid colors with distinct hues: one per ring block, then one per accent light."""
    return [hue(h / 360) for h in random.sample(range(0, 360, 15), n)]


def vent_preview(vent, shuffle):
    """Colors to show for the vent in loop order, or None for a solid color."""
    if vent == "random":
        return shuffle[: len(LOOP_ORDER)]
    return {"rainbow": RAINBOW, "wave": RAINBOW, "cycle": SPECTRUM}.get(vent)


def groups(vent, accents=(None, None, None), shuffle=None):
    """(zones, colors) pairs. colors is a hex color, or for the animated modes
    the colors to fade through in a loop. vent is a hex color or one of
    PATTERNS; accents are the logo, rear fan and CPU cooler colors, None to
    follow the vent."""
    blocks = [list(range(b * BLOCK, (b + 1) * BLOCK)) for b in LOOP_ORDER]
    n = len(ACCENT_ZONES)
    if vent == "cycle":
        pairs, follow = [(RING_ZONES, SPECTRUM)], [SPECTRUM] * n
    elif vent == "wave":
        pairs = [(zones, RAINBOW[p:] + RAINBOW[:p]) for p, zones in enumerate(blocks)]
        follow = [RAINBOW] * n
    elif vent == "rainbow":
        pairs, follow = list(zip(blocks, RAINBOW)), ["ffffff"] * n
    elif vent == "random":
        pairs, follow = list(zip(blocks, shuffle)), shuffle[len(LOOP_ORDER) :]
    else:
        pairs, follow = [(RING_ZONES, vent)], [vent] * n
    pairs += [(zones, own or f) for zones, own, f in zip(ACCENT_ZONES, accents, follow)]
    return pairs


def device_rgb(hex_color, brightness):
    """Brightness-scaled, gamma-corrected bytes; never pure black."""
    rgb = bytes(round(255 * (c / 255 * brightness / 100) ** GAMMA) for c in bytes.fromhex(hex_color))
    return rgb if any(rgb) else b"\x01\x01\x01"


def step_ms(speed):
    """Time per color in the animated modes, for speed 1-10; 5 is about 2 s."""
    return round(5000 * 0.8 ** (speed - 1))


def actions(colors, brightness, speed):
    if isinstance(colors, str):
        return [(MODE_COLOR, DURATION, TEMPO_MAX, device_rgb(colors, brightness))]
    duration = step_ms(speed)
    # 2000 ms at tempo 100 fades smoothly; keep that ratio at other speeds.
    tempo = max(15, min(TEMPO_MAX, duration // 20))
    return [(MODE_MORPH, duration, tempo, device_rgb(c, brightness)) for c in colors]


def set_lighting(pairs, brightness=100, speed=5, save=False):
    dev_pairs = [(zones, actions(c, brightness, speed)) for zones, c in pairs]
    with Elc() as dev:
        platform, _ = dev.config()
        if platform != PLATFORM:
            raise ControllerError(f"Controller platform is {platform:#06x}; this zone map is for the "
                                  f"Aurora ACT1250 ({PLATFORM:#06x})")
        dev.program(SLOT_LIVE, dev_pairs, ANIM_FINISH_PLAY)
        if save:
            dev.anim(ANIM_REMOVE, SLOT_DEFAULT)
            dev.program(SLOT_DEFAULT, dev_pairs, ANIM_FINISH_SAVE)
            dev.anim(ANIM_SET_DEFAULT, SLOT_DEFAULT)
            dev.anim(ANIM_SET_STARTUP, SLOT_DEFAULT)


def load_settings():
    try:
        with open(CONFIG_PATH) as f:
            stored = json.load(f)
    except (OSError, ValueError):
        stored = {}
    if "color" in stored:  # older versions only had the one color
        stored.setdefault("vent", stored.pop("color"))
    if "interior_on" in stored:  # the rear fan and CPU cooler used to share a color
        on, color = stored.pop("interior_on"), stored.pop("interior_color")
        for key in ("rear_fan", "cpu"):
            stored.setdefault(f"{key}_on", on)
            stored.setdefault(f"{key}_color", color)
    settings = {**DEFAULTS, **stored}
    if not settings["random"] or len(settings["random"]) != len(random_colors()):
        settings["random"] = random_colors()
    return settings


def store_settings(settings):
    with open(CONFIG_PATH, "w") as f:
        json.dump(settings, f)


def describe(vent, accents):
    text = {"rainbow": "Rainbow", "random": "Random", "cycle": "Color cycle",
            "wave": "Color wave"}.get(vent, f"#{vent}")
    extras = [f"a #{c} {name}" for name, c in zip(ACCENT_NAMES, accents) if c]
    return text + (" with " + ", ".join(extras) if extras else "")


class Worker(threading.Thread):
    """Runs controller updates off the UI thread. Only the newest request is
    kept: each takes a couple of seconds, so intermediate colors aren't worth sending."""

    def __init__(self, on_done):
        super().__init__(daemon=True)
        self.on_done = on_done
        self.cv = threading.Condition()
        self.job = None
        self.running = False

    def submit(self, lighting, save):
        with self.cv:
            self.job = (lighting, save)
            self.cv.notify()

    def busy(self):
        with self.cv:
            return self.running or self.job is not None

    def run(self):
        while True:
            with self.cv:
                while self.job is None:
                    self.cv.wait()
                lighting, save = self.job
                self.job = None
                self.running = True
            try:
                set_lighting(lighting["pairs"], lighting["brightness"], lighting["speed"], save)
                err = None
            except (ControllerError, OSError) as e:
                err = e
            with self.cv:
                self.running = False
            self.on_done(lighting, save, err)


def bands_css(colors):
    """A hard-stop gradient with each color as an equal stripe."""
    step = 100 / len(colors)
    stops = ", ".join(f"#{c} {i * step:.2f}%, #{c} {(i + 1) * step:.2f}%" for i, c in enumerate(colors))
    return f"linear-gradient(to right, {stops})"


def run_gui():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, GLib, Gtk

    css = f"""
    .swatch {{ min-width: 36px; min-height: 36px; padding: 0; border-radius: 9999px;
               border: 2px solid alpha(currentColor, 0.2); }}
    .swatch.selected {{ outline: 3px solid var(--accent-bg-color); outline-offset: 2px; }}
    .sw-rainbow {{ background: linear-gradient(to right, {", ".join("#" + c for c in RAINBOW)}); }}
    .sw-random {{ background: alpha(currentColor, 0.12); }}
    .sw-cycle {{ background: conic-gradient({", ".join("#" + c for c in SPECTRUM + SPECTRUM[:1])}); }}
    .sw-wave {{ background: repeating-linear-gradient(135deg, {", ".join(f"#{c} {i * 4}px" for i, c in enumerate(SPECTRUM + SPECTRUM[:1]))}); }}
    .preview {{ min-height: 96px; border-radius: 12px; border: 1px solid alpha(currentColor, 0.15); }}
    """ + "".join(f".sw-{v} {{ background: #{v}; }}\n" for _, v in PRESETS if v not in PATTERNS)

    def rgba(hex_color):
        c = Gdk.RGBA()
        c.parse("#" + hex_color)
        return c

    def hex_of(c):
        return "".join(f"{round(v * 255):02x}" for v in (c.red, c.green, c.blue))

    def shown(hex_color, brightness):
        """How a color looks on screen at a brightness, for the preview."""
        return "".join(f"{round(c * brightness / 100):02x}" for c in bytes.fromhex(hex_color))

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID)
            self.settings = load_settings()
            self.win = None
            self.debounce = 0
            self.quit_when_idle = False
            self.worker = Worker(lambda *a: GLib.idle_add(self.job_done, *a))
            self.worker.start()
            self.connect("activate", self.on_activate)

        def on_activate(self, _app):
            if self.win is None:
                self.build()
            self.win.present()

        def accent_row(self, key, title, subtitle):
            """A row with an own-color switch; off means it follows the vent."""
            s = self.settings
            btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False),
                                        valign=Gtk.Align.CENTER, sensitive=s[f"{key}_on"])
            btn.set_rgba(rgba(s[f"{key}_color"]))
            switch = Gtk.Switch(active=s[f"{key}_on"], valign=Gtk.Align.CENTER,
                                tooltip_text="Own color (off follows the vent)")

            def on_switch(*_):
                s[f"{key}_on"] = switch.get_active()
                btn.set_sensitive(switch.get_active())
                self.submit()

            def on_color(*_):
                s[f"{key}_color"] = hex_of(btn.get_rgba())
                if s[f"{key}_on"]:
                    self.submit()

            btn.connect("notify::rgba", on_color)
            switch.connect("notify::active", on_switch)
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            row.add_suffix(btn)
            row.add_suffix(switch)
            row.set_activatable_widget(switch)
            return row

        def build(self):
            s = self.settings
            display = Gdk.Display.get_default()
            base = Gtk.CssProvider()
            base.load_from_string(css)
            Gtk.StyleContext.add_provider_for_display(display, base, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.preview_css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_display(display, self.preview_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            self.win = Adw.ApplicationWindow(application=self, title="Alienware Lighting", default_width=480)
            self.win.connect("close-request", self.on_close)
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                          margin_top=12, margin_bottom=24, margin_start=24, margin_end=24)

            self.preview = Gtk.Box(css_classes=["preview"], tooltip_text="Front vent")
            box.append(self.preview)

            presets = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                  min_children_per_line=7, max_children_per_line=7,
                                  column_spacing=10, row_spacing=10)
            self.swatches = {}
            for name, value in PRESETS:
                b = Gtk.Button(css_classes=["swatch", f"sw-{value}"], tooltip_text=name,
                               halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
                if value == "random":
                    b.set_icon_name("media-playlist-shuffle-symbolic")
                b.connect("clicked", lambda _b, v=value: self.on_preset(v))
                presets.append(b)
                self.swatches[value] = b
            box.append(presets)

            # Initial values are set before the handlers connect so opening
            # the window doesn't send anything to the controller.
            self.color_btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False),
                                                   valign=Gtk.Align.CENTER)
            if s["vent"] not in PATTERNS:
                self.color_btn.set_rgba(rgba(s["vent"]))
            self.color_handler = self.color_btn.connect("notify::rgba", self.on_color)
            custom = Adw.ActionRow(title="Vent color", subtitle="Front ring; the swatches above set it too")
            custom.add_suffix(self.color_btn)
            custom.set_activatable_widget(self.color_btn)

            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 10, 100, 5)
            self.scale.set_size_request(220, -1)
            self.scale.set_digits(0)
            self.scale.set_draw_value(True)
            self.scale.set_value_pos(Gtk.PositionType.RIGHT)
            self.scale.set_value(s["brightness"])
            self.scale.connect("value-changed", self.on_brightness)
            bright = Adw.ActionRow(title="Brightness")
            bright.add_suffix(self.scale)

            speed = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 10, 1)
            speed.set_size_request(220, -1)
            speed.set_digits(0)
            speed.set_draw_value(True)
            speed.set_value_pos(Gtk.PositionType.RIGHT)
            speed.set_value(s["speed"])
            speed.connect("value-changed", self.on_speed)
            self.speed_row = Adw.ActionRow(title="Cycle speed", subtitle="Color cycle and color wave")
            self.speed_row.add_suffix(speed)

            group = Adw.PreferencesGroup()
            group.add(custom)
            group.add(self.accent_row("logo", "Logo", "Alien head on the power button"))
            group.add(self.accent_row("rear_fan", "Rear fan", "Fan at the back of the case"))
            group.add(self.accent_row("cpu", "CPU cooler", "Ring on the liquid cooler pump"))
            group.add(bright)
            group.add(self.speed_row)
            box.append(group)

            save = Gtk.Button(label="Keep After Reboot", css_classes=["pill", "suggested-action"],
                              halign=Gtk.Align.CENTER)
            save.connect("clicked", lambda _b: self.submit(save=True))
            box.append(save)

            status = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
            self.spinner = Adw.Spinner(visible=False)
            self.status = Gtk.Label(css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER)
            status.append(self.spinner)
            status.append(self.status)
            box.append(status)

            self.status.set_label(f"Startup lighting: {s['saved']}." if s["saved"] else
                                  "Changes apply right away. Keep After Reboot saves them to the controller.")
            view.set_content(box)
            self.win.set_content(view)
            self.refresh()

        def lighting(self):
            s = self.settings
            accents = [s[f"{k}_color"] if s[f"{k}_on"] else None for k in ACCENT_KEYS]
            return {"pairs": groups(s["vent"], accents, s["random"]),
                    "brightness": s["brightness"],
                    "speed": s["speed"],
                    "label": describe(s["vent"], accents)}

        def refresh(self):
            s = self.settings
            ring = vent_preview(s["vent"], s["random"])
            if ring is None:
                bg = "#" + shown(s["vent"], s["brightness"])
            else:
                bg = bands_css([shown(c, s["brightness"]) for c in ring])
            self.preview_css.load_from_string(f".preview {{ background: {bg}; }}")
            self.speed_row.set_sensitive(s["vent"] in ANIMATED)
            for value, btn in self.swatches.items():
                if value == s["vent"]:
                    btn.add_css_class("selected")
                else:
                    btn.remove_css_class("selected")

        def on_preset(self, value):
            if value == "random":
                self.settings["random"] = random_colors()
            self.settings["vent"] = value
            if value not in PATTERNS:
                with self.color_btn.handler_block(self.color_handler):
                    self.color_btn.set_rgba(rgba(value))
            self.submit()

        def on_color(self, *_):
            self.settings["vent"] = hex_of(self.color_btn.get_rgba())
            self.submit()

        def on_brightness(self, scale):
            self.settings["brightness"] = int(scale.get_value())
            self.refresh()
            self.submit_when_settled()

        def on_speed(self, scale):
            self.settings["speed"] = int(scale.get_value())
            self.submit_when_settled()

        def submit_when_settled(self):
            """Sliders send once they stop moving rather than on every step."""
            if self.debounce:
                GLib.source_remove(self.debounce)
            self.debounce = GLib.timeout_add(250, self.on_settled)

        def on_settled(self):
            self.debounce = 0
            self.submit()
            return GLib.SOURCE_REMOVE

        def submit(self, save=False):
            self.refresh()
            self.worker.submit(self.lighting(), save)
            self.spinner.set_visible(True)
            self.status.set_label("Saving to the controller…" if save else "Applying…")

        def job_done(self, lighting, save, err):
            if save and not err:
                self.settings["saved"] = lighting["label"]
            store_settings(self.settings)
            if self.worker.busy():
                return
            self.spinner.set_visible(False)
            if err:
                self.status.set_label(f"Couldn't update the lights: {err}")
            elif save:
                self.status.set_label(f"Saved. {lighting['label']} will come back after a reboot.")
            else:
                self.status.set_label("Applied. Keep After Reboot saves it to the controller.")
            if self.quit_when_idle:
                self.quit()

        def on_close(self, win):
            # Don't cut off a write to the controller halfway through.
            if self.worker.busy():
                win.set_visible(False)
                self.quit_when_idle = True
                return True
            return False

    App().run(None)


def main():
    ap = argparse.ArgumentParser(description="Set the Alienware Aurora ACT1250 case lighting.")
    ap.add_argument("vent", nargs="?",
                    help="vent color: hex such as 8000ff, or rainbow, random, cycle or wave; omit to open the window")
    ap.add_argument("--logo", help="logo color (default: follows the vent)")
    ap.add_argument("--rear-fan", help="rear fan color (default: follows the vent)")
    ap.add_argument("--cpu", help="CPU cooler color (default: follows the vent)")
    ap.add_argument("--interior", help="sets both the rear fan and CPU cooler")
    def in_range(lo, hi):
        def parse(value):
            if not value.isdigit() or not lo <= int(value) <= hi:
                raise argparse.ArgumentTypeError(f"must be {lo}-{hi}")
            return int(value)
        return parse

    ap.add_argument("--brightness", type=in_range(1, 100), default=100, metavar="1-100",
                    help="percent (default 100)")
    ap.add_argument("--speed", type=in_range(1, 10), default=5, metavar="1-10",
                    help="cycle and wave speed (default 5)")
    ap.add_argument("--save", action="store_true", help="also store it as the power-on lighting")
    args = ap.parse_args()
    if args.vent is None:
        run_gui()
        return

    def norm(c):
        return c.lower().lstrip("#") if c else None

    try:
        accents = [norm(args.logo), norm(args.rear_fan or args.interior), norm(args.cpu or args.interior)]
        pairs = groups(norm(args.vent), accents, random_colors())
        set_lighting(pairs, args.brightness, args.speed, args.save)
    except ValueError:
        raise SystemExit("Colors are hex like 8000ff; the vent can also be rainbow, random, cycle or wave")
    except ControllerError as e:
        raise SystemExit(str(e))


if __name__ == "__main__":
    main()
